{
  "name": "flight-school",
  "version": "0.1.0",
  "description": "Fold procedural paper aircraft, earn their wings, and fly them through a cinematic school hallway.",
  "private": true,
  "license": "MIT",
  "homepage": "https://flight-school-chi.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmuz-dev/flight-school.git"
  },
  "bugs": {
    "url": "https://github.com/kmuz-dev/flight-school/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:audit": "tsx scripts/i18n-audit.ts",
    "validate:content": "vitest run tests/content"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.120.0"
  }
}
